# Copy this file to .env and adjust values before running docker compose.

# Database password for the postgres container.
DB_PASSWORD=trafficgym

# Django secret key — change this before sharing or deploying.
SECRET_KEY=django-insecure-change-me

# --- sumo-gui (Open GUI mode) ---
# sumo-gui opens on the Celery worker machine, not in the browser.
# The worker needs access to your X11 display.
#
# Linux:
#   1. Allow Docker to connect to your display:
#        xhost +local:docker
#   2. Set DISPLAY to your session value (usually :0 or :1):
#        DISPLAY=:0
#
# macOS (XQuartz):
#   1. Install XQuartz and enable "Allow connections from network clients"
#      in XQuartz > Settings > Security.
#   2. Restart XQuartz, then:
#        xhost + 127.0.0.1
#   3. Set DISPLAY to the XQuartz TCP address:
#        DISPLAY=host.docker.internal:0
#
# Windows (VcXsrv / X410):
#   Set DISPLAY to your host IP:
#        DISPLAY=<your-windows-ip>:0
#
DISPLAY=:0
